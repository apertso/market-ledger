{
  "name": "realtime-market-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:wasm && ng serve",
    "build:wasm": "asc assembly/producer.ts --outFile public/producer.wasm --runtime stub --optimize",
    "build": "npm run build:wasm && ng build",
    "test": "npm run build:wasm && npm run test:wasm && ng test --watch=false",
    "test:wasm": "node --test tests/producer.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@tanstack/angular-virtual": "6.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "assemblyscript": "0.28.20",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
